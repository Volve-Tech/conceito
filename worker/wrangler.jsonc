{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "conceito-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://volve-tech.github.io,https://conceitocontabilidade.com.br,http://localhost:4321,http://127.0.0.1:4321"
  }
}
