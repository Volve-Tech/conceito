# Contentful Delivery API — used only by `npm run snapshot`
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# Canonical site URL used for SEO, sitemap, and robots
SITE_URL=https://conceitocontabilidade.com.br

# Production indexing: allow | disallow
INDEXING_POLICY=allow

# Contact form (public at build time). Leave empty to keep the form disabled.
# Absolute Worker URL — do not use /api/contact or publicHref.
# After `npm run contact:deploy`: https://conceito-contact.artur8676.workers.dev
PUBLIC_CONTACT_API_URL=
PUBLIC_RECAPTCHA_SITE_KEY=
