---
interface Props {
  headline?: string | null;
  subline?: string | null;
  align?: 'center' | 'left';
  class?: string;
  headlineColor?: string;
  textColor?: string;
}

const {
  headline,
  subline,
  align = 'center',
  class: className = '',
  headlineColor,
  textColor,
} = Astro.props;
---

{(headline || subline) && (
  <div class:list={['section-headlines', align === 'center' && 'is-centered', className]}>
    {headline && (
      <h2 class="headline" style={headlineColor ? `color:${headlineColor}` : undefined}>{headline}</h2>
    )}
    {subline && (
      <p class="subline" style={textColor ? `color:${textColor}` : undefined}>{subline}</p>
    )}
  </div>
)}

<style>
  .is-centered {
    text-align: center;
  }

  .headline {
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.083;
  }

  .subline {
    font-weight: 400;
    line-height: 1.56;
    margin-top: 3rem;
    font-size: 1.8rem;
    color: #414d63;
  }
</style>
