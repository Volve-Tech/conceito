---
import { sanitizeTitleHtml } from '../../lib/sanitize';

export interface Props {
  title?: string | null;
  class?: string;
  as?: 'h1' | 'h2' | 'h3';
  color?: string;
  variant?: 'default' | 'section' | 'location';
}

/**
 * Contentful HTML title. Variants live here so section styles are not lost
 * to Astro scoped CSS (parent `.headline` does not pierce this root).
 */
const {
  title,
  class: className = '',
  as: Tag = 'h2',
  color,
  variant = 'default',
} = Astro.props;
const html = sanitizeTitleHtml(title);
---

<Tag
  class:list={['ctf-title', `is-${variant}`, className]}
  style={color ? `color:${color}` : undefined}
  set:html={html}
/>

<style>
  .ctf-title {
    font-size: 3.8rem;
    line-height: 1.089;
    font-weight: 600;
  }

  .is-section {
    font-size: 3rem;
    line-height: 1.3;
    font-weight: 400;
    max-width: 60.4rem;
    margin-top: 5rem;
  }

  .is-location {
    font-size: 3.5rem;
    letter-spacing: -0.25rem;
    line-height: 1.3;
    font-weight: 600;
    max-width: 60.4rem;
    margin-top: 5rem;
  }

  @media (min-width: 1536px) {
    .is-section {
      font-size: 3.5rem;
    }

    .is-location {
      font-size: 5rem;
    }
  }

  @media (max-width: 899px) {
    .is-location {
      font-size: 1.5rem;
      margin-top: 0;
      font-weight: 300;
      letter-spacing: 0;
    }
  }
</style>
