---
import { getColorConfigFromPalette, defaultLayout } from '../../lib/theme';
import { getEntry } from '../../lib/content';
import PageLink from '../shared/PageLink.astro';
import RichText from '../shared/RichText.astro';
import SwiperNav from '../shared/SwiperNav.astro';
import Title from '../shared/Title.astro';
import ServiceItem from './ServiceItem.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry, locale } = Astro.props;
const color = getColorConfigFromPalette(entry.colorPalette);
const items = (entry.servicesCollection?.items || [])
  .filter(Boolean)
  .map((item: any) => getEntry(locale, item.__typename, item.sys.id))
  .filter(Boolean);
---

<section class="services" style={`background-color:${color.backgroundColor}`}>
  <div class="inner">
    {entry.headline && (
      <Title title={entry.headline} variant="section" color={color.headlineColor} />
    )}
    {items.length > 0 && (
      <div class="carousel">
        <div class="swiper" data-swiper="services">
          <div class="swiper-wrapper">
            {items.map((item: any) => (
              <div class="swiper-slide">
                <ServiceItem entry={item} locale={locale} />
              </div>
            ))}
          </div>
          <SwiperNav variant="white" />
        </div>
      </div>
    )}
    <div class="bottom">
      <div>
        {entry.bodyText && (
          <RichText field={entry.bodyText} locale={locale} layout={{ ...defaultLayout, parent: 'service' }} class="rich" />
        )}
      </div>
      {entry.targetPage?.slug && (
        <div class="cta">
          <PageLink page={entry.targetPage} locale={locale} variant="contained" type="secondary">
            {entry.ctaText}
          </PageLink>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .services {
    width: 100%;
  }

  .inner {
    margin: 0 auto;
    max-width: 126rem;
    padding: 4rem 2.5rem;
  }

  .carousel {
    margin: 10rem 0;
    width: 100%;
  }

  .bottom {
    margin-top: 2.5rem;
    display: grid;
    gap: 2rem;
  }

  .cta {
    display: flex;
    justify-content: flex-end;
    margin-top: 4rem;
    width: max-content;
    margin-left: auto;
  }

  .bottom :global(.rich .rt-p) {
    color: #fff;
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.56;
  }

  @media (min-width: 600px) {
    .bottom {
      grid-template-columns: 1fr 2fr;
    }
  }

  @media (min-width: 1536px) {
    .bottom :global(.rich .rt-p) {
      font-size: 1.8rem;
    }
  }
</style>
