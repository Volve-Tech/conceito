---
import Title from '../shared/Title.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry } = Astro.props;
const apiUrl = import.meta.env.PUBLIC_CONTACT_API_URL?.trim() ?? '';
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY?.trim() ?? '';
const configured = Boolean(apiUrl && siteKey);
---

<section class="contact">
  <div class="copy">
    {entry.title && <Title title={entry.title} variant="section" />}
  </div>
  <form
    class="form"
    data-contact-form
    data-contact-api={configured ? apiUrl : undefined}
    data-recaptcha-site-key={configured ? siteKey : undefined}
    novalidate
  >
    {
      !configured && (
        <p class="notice" data-contact-notice>
          O envio de mensagens estará disponível após a configuração do backend de e-mail.
        </p>
      )
    }
    <p class="notice is-success" data-contact-success hidden>Email enviado com sucesso!</p>
    <p class="notice is-error" data-contact-error hidden>Erro ao enviar email</p>
    <label>
      Nome
      <input type="text" name="name" autocomplete="name" required />
      <span class="field-error" data-error-for="name" hidden>Nome é obrigatório</span>
    </label>
    <label>
      Email
      <input type="email" name="email" autocomplete="email" required />
      <span class="field-error" data-error-for="email" hidden>Coloque um email válido</span>
    </label>
    <label>
      Telefone
      <input type="tel" name="phone" autocomplete="tel" required />
      <span class="field-error" data-error-for="phone" hidden>Telefone é obrigatório</span>
    </label>
    <label>
      Mensagem
      <textarea name="message" rows="4" required></textarea>
      <span class="field-error" data-error-for="message" hidden>Mensagem não pode ser vazio</span>
    </label>
    <button type="submit" class="submit" disabled={!configured}>Enviar</button>
  </form>
</section>

{
  configured && (
    <script
      is:inline
      src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(siteKey)}`}
      async
      defer
    />
  )
}

<style>
  .contact {
    margin: 0 auto;
    max-width: 126rem;
    padding: 4rem 2.5rem 4rem;
    display: grid;
    gap: 3rem;
  }

  .form {
    display: grid;
    gap: 1.6rem;
  }

  label {
    display: grid;
    gap: 0.6rem;
    font-size: 1.5rem;
  }

  input,
  textarea {
    border: 0;
    border-bottom: 1px solid #000;
    padding: 1.35rem 1.4rem;
    background: transparent;
  }

  .submit {
    font-size: 1.5rem;
    border-radius: 200px;
    background: #001bdb;
    color: #fff;
    border: 1px solid #001bdb;
    padding: 1.2rem 3rem;
    width: fit-content;
  }

  .submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .notice {
    background: #fff3cd;
    color: #664d03;
    padding: 1.2rem 1.6rem;
    border-radius: 8px;
    font-size: 1.5rem;
  }

  .notice.is-success {
    background: #d1e7dd;
    color: #0f5132;
  }

  .notice.is-error {
    background: #f8d7da;
    color: #842029;
  }

  .field-error {
    font-size: 1.3rem;
    color: #842029;
  }

  @media (min-width: 600px) {
    .contact {
      grid-template-columns: 1fr 1fr;
    }

    .form {
      padding-top: 5rem;
    }
  }

  @media (max-width: 899px) {
    .contact {
      background: #001bdb;
      color: #fff;
    }

    input,
    textarea {
      border-bottom-color: #fff;
      color: #fff;
    }

    .submit {
      background: #fff;
      color: #001bdb;
    }

    .field-error {
      color: #ffd6d6;
    }
  }
</style>
