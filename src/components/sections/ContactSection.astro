---
import Title from '../shared/Title.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry } = Astro.props;
---

<section class="contact">
  <div class="copy">
    {entry.title && <Title title={entry.title} variant="section" />}
  </div>
  <form class="form" data-contact-form novalidate>
    <p class="notice" data-contact-notice>
      O envio de mensagens estará disponível após a configuração do backend de e-mail.
    </p>
    <label>
      Nome
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      Email
      <input type="email" name="email" autocomplete="email" required />
    </label>
    <label>
      Telefone
      <input type="tel" name="phone" autocomplete="tel" required />
    </label>
    <label>
      Mensagem
      <textarea name="message" rows="4" required></textarea>
    </label>
    <button type="submit" class="submit" disabled>Enviar</button>
  </form>
</section>

<style>
  .contact {
    margin: 0 auto;
    max-width: 126rem;
    padding: 4rem 2.5rem 4rem;
    display: grid;
    gap: 3rem;
  }

  .form {
    display: grid;
    gap: 1.6rem;
  }

  label {
    display: grid;
    gap: 0.6rem;
    font-size: 1.5rem;
  }

  input,
  textarea {
    border: 0;
    border-bottom: 1px solid #000;
    padding: 1.35rem 1.4rem;
    background: transparent;
  }

  .submit {
    font-size: 1.5rem;
    border-radius: 200px;
    background: #001bdb;
    color: #fff;
    border: 1px solid #001bdb;
    padding: 1.2rem 3rem;
    width: fit-content;
  }

  .submit:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .notice {
    background: #fff3cd;
    color: #664d03;
    padding: 1.2rem 1.6rem;
    border-radius: 8px;
    font-size: 1.5rem;
  }

  @media (min-width: 600px) {
    .contact {
      grid-template-columns: 1fr 1fr;
    }

    .form {
      padding-top: 5rem;
    }
  }

  @media (max-width: 899px) {
    .contact {
      background: #001bdb;
      color: #fff;
    }

    input,
    textarea {
      border-bottom-color: #fff;
      color: #fff;
    }

    .submit {
      background: #fff;
      color: #001bdb;
    }
  }
</style>
