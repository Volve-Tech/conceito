---
import { publicHref } from '../../lib/hrefs';
import { getColorConfigFromPalette, defaultLayout } from '../../lib/theme';
import { imageAlt, optimizeLineBreak } from '../../lib/sanitize';
import { isClientLogoDuplex } from '../../data/client-logos';
import PageLink from '../shared/PageLink.astro';
import RichText from '../shared/RichText.astro';
import Title from '../shared/Title.astro';
import LogoGrid from './LogoGrid.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry, locale } = Astro.props;
const color = getColorConfigFromPalette(entry.colorPalette);
const isOnlyImage = !entry.headline && !entry.bodyText;
const isLogoGrid = isClientLogoDuplex(entry, isOnlyImage);
const imageFirst = Boolean(entry.containerLayout);
const imageFixed = Boolean(entry.imageStyle);
---

<section class="duplex" style={`background-color:${color.backgroundColor}`}>
  {entry.title && (
    <div class="full">
      <Title title={entry.title} class="duplex-title" color={color.headlineColor} />
    </div>
  )}
  {isOnlyImage ? (
    <div class="full">
      {isLogoGrid ? (
        <LogoGrid />
      ) : (
        entry.image?.url && (
          <img
            class:list={['image', imageFixed && 'is-fixed']}
            src={publicHref(entry.image.url)}
            alt={imageAlt(entry.image.title, entry.image.description, entry.headline)}
            width={entry.image.width || undefined}
            height={entry.image.height || undefined}
          />
        )
      )}
    </div>
  ) : (
    <div class="grid">
      {imageFirst && entry.image?.url && (
        <div class="media">
          <img class:list={['image', imageFixed && 'is-fixed']} src={publicHref(entry.image.url)} alt={imageAlt(entry.image.title, entry.image.description, entry.headline)} width={entry.image.width || undefined} height={entry.image.height || undefined} />
        </div>
      )}
      <div class="content">
        {entry.headline && <h3 class="headline" style={`color:${color.headlineColor}`}>{optimizeLineBreak(entry.headline)}</h3>}
        {entry.bodyText && (
          <div class="body" style={`color:${color.textColor}`}>
            <RichText field={entry.bodyText} locale={locale} layout={{ ...defaultLayout, parent: 'duplex' }} class="rich" />
          </div>
        )}
        {entry.targetPage?.slug && (
          <div class="cta">
            <PageLink page={entry.targetPage} locale={locale} variant="contained" type="secondary-light">
              {entry.ctaText}
              <img src={publicHref('/assets/brand/tick-button.svg')} alt="" class="tick" width="24" height="24" />
            </PageLink>
          </div>
        )}
      </div>
      {!imageFirst && entry.image?.url && (
        <div class="media">
          <img class:list={['image', imageFixed && 'is-fixed']} src={publicHref(entry.image.url)} alt={imageAlt(entry.image.title, entry.image.description, entry.headline)} width={entry.image.width || undefined} height={entry.image.height || undefined} />
        </div>
      )}
    </div>
  )}
</section>

<style>
  .duplex {
    width: 100%;
  }

  .grid,
  .full {
    display: grid;
    margin: 0 auto;
    max-width: 126rem;
    padding: 4rem 2.5rem;
    gap: 3.5rem;
  }

  .full {
    display: block;
    margin-top: 3rem;
  }

  .full :global(.duplex-title) {
    line-height: 1.5;
    font-weight: 400;
  }

  .content {
    margin: auto 0;
  }

  .media {
    display: flex;
    align-items: center;
    border-radius: 16px;
  }

  .headline {
    font-size: 3rem;
    line-height: 1.3;
    font-weight: 400;
    max-width: 60.4rem;
  }

  .body {
    margin-top: 3.5rem;
  }

  .cta {
    margin-top: 4rem;
  }

  .tick {
    margin-left: 2.5rem;
    display: inline-block;
  }

  .image {
    display: block;
    margin: auto 0;
    max-width: 100%;
    border-radius: 16px;
    height: auto;
  }

  .is-fixed {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .body :global(.rich .rt-p) {
    font-size: 2.5rem;
    font-weight: 400;
    line-height: 1.56;
    color: #414d63;
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 7rem;
    }
  }

  @media (min-width: 1536px) {
    .headline {
      font-size: 3.5rem;
    }

    .body :global(.rich .rt-p) {
      font-size: 1.8rem;
    }
  }
</style>
