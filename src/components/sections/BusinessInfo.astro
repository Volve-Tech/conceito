---
import { publicHref } from '../../lib/hrefs';
import { defaultLayout } from '../../lib/theme';
import { imageAlt } from '../../lib/sanitize';
import RichText from '../shared/RichText.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry, locale } = Astro.props;
const bg = entry.featuredImage?.url;
const hasHero = Boolean(entry.name || entry.shortDescription || bg);
const youtubeId = typeof entry.youtube === 'string'
  ? entry.youtube.match(/(?:youtube\.com\/(?:[^/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?/\s]{11})/)?.[1]
  : null;
const youtube = entry.youtube?.includes('youtube.com/embed/')
  ? entry.youtube
  : youtubeId
    ? `https://www.youtube.com/embed/${youtubeId}`
    : null;
---

<article class:list={['biz', entry.isDark && 'is-dark', entry.body && 'has-body', !hasHero && 'no-hero']}>
  {hasHero && (
    <header class="hero">
      {bg && <div class="hero-bg" style={`background-image:url(${publicHref(bg)})`}></div>}
      <div class="hero-inner">
        {entry.name && <h2 class="name">{entry.name}</h2>}
        {entry.shortDescription && <h1 class="subtitle">{entry.shortDescription}</h1>}
      </div>
    </header>
  )}
  {(entry.media?.url || youtube) && (
    <div class="media">
      {youtube ? (
        <iframe
          class="iframe"
          src={youtube}
          title="YouTube video player"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      ) : (
        <img src={publicHref(entry.media.url)} alt={imageAlt(entry.media.title, entry.media.description, entry.name)} width={entry.media.width || undefined} height={entry.media.height || undefined} />
      )}
    </div>
  )}
  {entry.body && (
    <div class="body">
      <RichText field={entry.body} locale={locale} layout={defaultLayout} />
    </div>
  )}
</article>

<style>
  .biz {
    width: 100%;
  }

  .has-body {
    padding-bottom: 9rem;
  }

  .no-hero {
    padding-top: 9rem;
  }

  .hero {
    position: relative;
    margin-bottom: 9rem;
  }

  .hero-bg {
    background: #000 center/cover;
    position: absolute;
    inset: 0;
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    color: #fff;
    max-width: 126.2rem;
    margin: 0 auto;
    padding: 4rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .name {
    font-size: 2.5rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .subtitle {
    font-size: 4.5rem;
    margin-top: 5rem;
    font-weight: 300;
  }

  @media (min-width: 900px) {
    .hero-inner {
      padding: 8rem 2.5rem;
    }
  }

  @media (min-height: 600px) {
    .hero-inner {
      min-height: 59rem;
    }
  }

  .media {
    background: linear-gradient(to bottom, white 50%, black 50%);
    margin-top: -9rem;
    padding: 10rem 2.5rem 5rem;
    display: flex;
    justify-content: center;
  }

  .iframe {
    width: 750px;
    height: 422px;
    border: 0;
    max-width: 100%;
  }

  .body {
    max-width: 110rem;
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .is-dark {
    background: #000;
  }

  .is-dark .body :global(.rt-p) {
    color: #fff;
  }

  @media (max-width: 750px) {
    .iframe {
      width: 100%;
      height: 400px;
    }
  }
</style>
