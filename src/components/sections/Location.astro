---
import Title from '../shared/Title.astro';

interface Props {
  entry: any;
  locale: string;
}

const { entry } = Astro.props;
---

<div class="location">
  <Title title={entry.name} variant="location" />
  {entry.address && (
    <p class="address">
      <a href={entry.url || '#'} target="_blank" rel="noreferrer">{entry.address}</a>
    </p>
  )}
</div>

<style>
  .address {
    font-size: 1.4rem;
    line-height: 1.8;
    font-weight: 400;
    margin: 1rem 0 -1rem;
  }

  .address a {
    color: inherit;
    text-decoration: none;
  }

  @media (max-width: 899px) {
    .address {
      display: none;
    }
  }
</style>
