---
import '../styles/global.css';
import '../styles/rich-text.css';
import 'swiper/css';
import 'swiper/css/navigation';
import '../styles/swiper-nav.css';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import MobileMenu from '../components/chrome/MobileMenu.astro';
import { getStrings } from '../lib/content';
import { GA_MEASUREMENT_ID, SITE_NAME, SITE_TAGLINE } from '../lib/theme';
import { publicHref, resolveAbsoluteHref } from '../lib/hrefs';

interface Props {
  locale: string;
  slug?: string;
  title?: string | null;
  description?: string | null;
  image?: string | null;
  noIndex?: boolean | null;
  noFollow?: boolean | null;
}

const {
  locale,
  slug = 'home',
  title,
  description,
  image,
  noIndex = false,
  noFollow = false,
} = Astro.props;

const strings = getStrings(locale);
const pageTitle = title || SITE_NAME;
const pageDescription = description || SITE_TAGLINE;
const canonical = resolveAbsoluteHref(slug, locale, Astro.site?.toString() || 'https://conceitocontabilidade.com.br');
const robots = [noIndex ? 'noindex' : 'index', noFollow ? 'nofollow' : 'follow'].join(', ');
const ogLocale = locale.replace('-', '_');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {image && <meta property="og:image" content={new URL(image, Astro.site).toString()} />}
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <link rel="icon" href={publicHref('/favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@300..800&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', GA_MEASUREMENT_ID);
    </script>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
  </head>
  <body>
    <div class="app-shell">
      <Header locale={locale} strings={strings} />
      <main class="app-content">
        <div class="page-container">
          <slot />
        </div>
      </main>
      <Footer locale={locale} />
      <MobileMenu locale={locale} />
    </div>
    <script is:inline src={publicHref('/scripts/ui.js')}></script>
    <script>
      import { initCarousels } from '../scripts/carousels';
      initCarousels();
    </script>
  </body>
</html>
