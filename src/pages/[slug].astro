---
import Base from '../layouts/Base.astro';
import PageView from '../components/sections/PageView.astro';
import { getManifest, getPage } from '../lib/content';
import { DEFAULT_LOCALE } from '../lib/theme';

export function getStaticPaths() {
  return getManifest()
    .pages.filter((page) => page.locale === DEFAULT_LOCALE && page.slug !== 'home')
    .map((page) => ({ params: { slug: page.slug } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug');
const page = getPage(DEFAULT_LOCALE, slug);
if (!page) throw new Error(`Missing page snapshot ${slug}`);
---

<Base
  locale={DEFAULT_LOCALE}
  slug={slug}
  title={page.seo?.title || page.pageName}
  description={page.seo?.description}
  image={page.seo?.image?.url}
  noIndex={page.seo?.noIndex}
  noFollow={page.seo?.noFollow}
>
  <PageView page={page} locale={DEFAULT_LOCALE} />
</Base>
