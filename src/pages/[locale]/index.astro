---
import Base from '../../layouts/Base.astro';
import PageView from '../../components/sections/PageView.astro';
import { getManifest, getPage } from '../../lib/content';
import { DEFAULT_LOCALE } from '../../lib/theme';

export function getStaticPaths() {
  return getManifest()
    .pages.filter((page) => page.locale !== DEFAULT_LOCALE && page.slug === 'home')
    .map((page) => ({ params: { locale: page.locale } }));
}

const { locale } = Astro.params;
if (!locale) throw new Error('Missing locale');
const page = getPage(locale, 'home');
if (!page) throw new Error(`Missing home snapshot for ${locale}`);
---

<Base
  locale={locale}
  slug="home"
  title={page.seo?.title || page.pageName}
  description={page.seo?.description}
  image={page.seo?.image?.url}
  noIndex={page.seo?.noIndex}
  noFollow={page.seo?.noFollow}
>
  <PageView page={page} locale={locale} />
</Base>
